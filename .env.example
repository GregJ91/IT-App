# Copy to .env and fill in.
DATABASE_URL=postgres://postgres@localhost:5432/ithub
APP_URL=http://localhost:3000
# Long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Who can create a staff account without an invite (comma separated)
ALLOWED_EMAIL_DOMAINS=gardenersdream.co.uk

# First IT admin. `npm run db:seed` prints an invite link for this address.
ADMIN_EMAIL=
ADMIN_NAME=

# Sign-in providers. Leave blank to hide a button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Email notifications. Leave SMTP_HOST blank to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IT Hub <it@gardenersdream.co.uk>"

# Where screenshots are stored
UPLOAD_DIR=./uploads

# Slack notifications (see docs/slack-setup.md). Either a bot token + channel ID (recommended:
# threads per job and direct messages) or just an incoming webhook URL (channel posts only).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_WEBHOOK_URL=

# Optional: a scheduler can call /api/cron/reminders daily with "Authorization: Bearer <this>".
# Without it, reminders are sent the first time someone in IT opens the dashboard each day.
CRON_SECRET=
